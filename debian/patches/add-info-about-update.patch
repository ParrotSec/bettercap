Description: Add information about updates disabled.
 Display the information that updates are disabled in Parrot
 when the user uses the command "bettercap -eval ..."
Author: Sophie Brun <sophie@offensive-security.com>
Origin: Kali Linux, https://gitlab.com/kalilinux/packages/bettercap/-/raw/b97175cfd96369ca42aa931ac08eba81444586f4/debian/patches/add-info-about-update.patch
Forwarded: not-needed
Reviewed-By: Steev Klimaszewski <threeway@gmail.com>
Last-Update: 2026-04-15

--- a/main.go
+++ b/main.go
@@ -63,6 +63,9 @@ func main() {
 	// line, therefore they need to be executed first otherwise
 	// modules might already be started.
 	for _, cmd := range session.ParseCommands(sess.Options.Commands) {
+        if strings.Contains(cmd, "update") {
+                fmt.Printf("%s is disabled in Parrot. Please use apt\n", cmd)
+        }
 		if err = sess.Run(cmd); err != nil {
 			log.Error("error while running '%s': %s", tui.Bold(cmd), tui.Red(err.Error()))
 		}
